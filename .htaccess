# IONOS Apache Configuration for Blackmarkt (React SPA + Laravel API)
AddHandler x-mapp-php8.2 .php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Deny direct access to backend internal directories
    RewriteRule ^backend/(app|bootstrap|config|database|resources|routes|storage|tests|vendor|\.env) - [F,L]

    # Route API and Admin to Laravel
    RewriteRule ^api/(.*)$ backend/public/index.php [L,QSA]
    RewriteRule ^admin(.*)$ backend/public/index.php [L,QSA]
    RewriteRule ^login$ backend/public/index.php [L,QSA]
    RewriteRule ^logout$ backend/public/index.php [L,QSA]
    RewriteRule ^sanctum/(.*)$ backend/public/index.php [L,QSA]

    # Static files and existing directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA fallback for React Client-Side Router
    RewriteRule ^ index.html [L]
</IfModule>

# Browser Caching for Performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

